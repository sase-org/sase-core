{
  "auth": {
    "bootstrap": {
      "default_ttl_seconds": 600,
      "issuer": "local-only Rust FleetCredentialStore::issue_bootstrap API",
      "secret_storage": "sha256(domain || secret)",
      "single_use": true
    },
    "header": "Authorization",
    "request_hot_path": {
      "cache_refresh": "only when credentials.json metadata changes",
      "durable_writes": false
    },
    "scheme": "bearer",
    "unauthenticated_routes": [
      "POST /api/fleet/v1/enroll"
    ]
  },
  "base_path": "/api/fleet/v1",
  "contract": "sase_fleet_gateway_api_v1",
  "limits": {
    "batch_max_logical_keys": 200,
    "catalog_default_page_rows": 50,
    "catalog_max_page_rows": 100,
    "content_default_bytes": 65536,
    "content_max_bytes": 262144,
    "enrollment_attempts": 8,
    "enrollment_window_seconds": 60,
    "event_default_replay_events": 128,
    "event_max_replay_events": 512,
    "filter_max_bytes": 128,
    "project_eligibility_max_project_ids": 200,
    "query_max_bytes": 512,
    "request_body_bytes": 16384
  },
